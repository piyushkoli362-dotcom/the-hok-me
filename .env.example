# Public project URL and publishable/anon key. Server only; never add a NEXT_PUBLIC prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to SUPABASE_PUBLISHABLE_KEY:
SUPABASE_ANON_KEY=

# Server-only privileged key; used only by the validated inquiry RPC and Sheets outbox worker.
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=

# Generate a random 32+ byte secret; only an HMAC of the client IP is stored for rate limiting.
RATE_LIMIT_HASH_SECRET=

# Owner/admin logins require TOTP AAL2 unless explicitly disabled for local development.
OWNER_REQUIRE_AAL2=true

# Optional private Google Apps Script web app mirror. Database leads remain authoritative.
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_SECRET=
CRON_SECRET=
